<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.KnowledgeBaseMapper">

    <select id="selectAll" resultType="com.example.entity.KnowledgeBase">
        select * from `knowledge_base`
        <where>
            <if test="name != null"> and name like concat('%', #{name}, '%')</if>
            <if test="code != null"> and code like concat('%', #{code}, '%')</if>
            <if test="status != null"> and status = #{status}</if>
        </where>
        order by id desc
    </select>

    <delete id="deleteById">
        delete from `knowledge_base`
        where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.KnowledgeBase" useGeneratedKeys="true">
        insert into `knowledge_base`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="code != null">code,</if>
            <if test="description != null">description,</if>
            <if test="chunkSize != null">chunk_size,</if>
            <if test="overlapSize != null">overlap_size,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="code != null">#{code},</if>
            <if test="description != null">#{description},</if>
            <if test="chunkSize != null">#{chunkSize},</if>
            <if test="overlapSize != null">#{overlapSize},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.KnowledgeBase">
        update `knowledge_base`
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="code != null">
                code = #{code},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="chunkSize != null">
                chunk_size = #{chunkSize},
            </if>
            <if test="overlapSize != null">
                overlap_size = #{overlapSize},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        where id = #{id}
    </update>

</mapper>
